<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PeripheralBatteryMonitor.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <MauiVersion>10.0.20</MauiVersion>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Peripheral Battery Monitor</ApplicationTitle>
    <ApplicationIcon>../../assets/branding/app-icon.ico</ApplicationIcon>
    <ApplicationId>io.github.vhnatovskyi.peripheralbatterymonitor</ApplicationId>
    <ApplicationDisplayVersion>0.5.2</ApplicationDisplayVersion>
    <ApplicationVersion>52</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <SatelliteResourceLanguages>en;uk</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.png" Color="#101820" />
    <MauiSplashScreen Include="Resources/Splash/splash.png" Color="#101820" BaseSize="96,96" />
    <MauiImage Include="Resources/Images/*.svg" />
    <MauiImage Include="Resources/Images/brand.png" BaseSize="72,72" Resize="true" />
    <Content Include="../../assets/branding/app-icon.ico" Link="app-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Core/*.cs" Link="DeviceCore/%(Filename)%(Extension)" />
    <Compile Include="../Devices/*.cs" Link="DeviceProviders/%(Filename)%(Extension)" />
    <Compile Include="../UI/TrayBatteryPainter.cs" Link="WindowsTray/TrayBatteryPainter.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>
</Project>
